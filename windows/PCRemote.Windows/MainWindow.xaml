<Window x:Class="PCRemote.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Remote" Width="1060" Height="760" MinWidth="820" MinHeight="600" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True" SourceInitialized="OnSourceInitialized" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" Closing="OnClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource NavBrush}" Padding="18">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="8,8,8,28"><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock Text="PC Remote" FontSize="21" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
          <Button Style="{StaticResource NavigationButton}" Tag="Selected" x:Name="HomeButton" HorizontalContentAlignment="Left" Click="ShowHome"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Главная"/></StackPanel></Button>
          <Button x:Name="DevicesButton" Style="{StaticResource NavigationButton}" HorizontalContentAlignment="Left" Click="ShowDevices"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Устройства"/></StackPanel></Button>
          <Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" HorizontalContentAlignment="Left" Click="ShowSettings"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="28"/><TextBlock Text="Настройки"/></StackPanel></Button>
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="Локально и безопасно" Foreground="{DynamicResource SecondaryTextBrush}" Margin="8"/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="32">
      <ScrollViewer x:Name="HomePanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <TextBlock Text="Главная" FontSize="30" FontWeight="SemiBold"/>
          <TextBlock Text="Управление компьютером в локальной сети" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,24"/>
          <UniformGrid Columns="2">
            <Border Style="{StaticResource Card}" Margin="0,0,10,10"><StackPanel><TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Имя компьютера" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/><TextBlock x:Name="ComputerNameText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="10,0,0,10"><StackPanel><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Локальный сервер" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/><TextBlock Style="{StaticResource StatusValue}" x:Name="ServerStatusText" Text="Запуск…" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,10,10,0"><StackPanel><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Обнаружение в сети" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/><TextBlock Style="{StaticResource StatusValue}" x:Name="DiscoveryStatusText" Text="Запуск…" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="10,10,0,0"><StackPanel><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Привязанные устройства" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,12,0,0"/><TextBlock x:Name="DeviceCountText" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
          </UniformGrid>
        </StackPanel>
      </ScrollViewer>
      <Grid x:Name="DevicesPanel" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel LastChildFill="True"><Button DockPanel.Dock="Right" Click="CreatePairing" Content="Добавить телефон" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="Устройства" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Телефоны с доступом к компьютеру" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DockPanel>
        <Grid Grid.Row="1" Margin="0,24,0,0"><ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="DevicesList" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Margin="0,0,0,10"><DockPanel><Button Style="{StaticResource DestructiveButton}" Margin="16,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Tag="{Binding Id}" Click="RevokeDevice"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" Margin="0,0,8,0"/><TextBlock Text="Отвязать"/></StackPanel></Button><DockPanel><TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding LastSeenDisplay}" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></DockPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          <Border x:Name="PairingCard" Visibility="Collapsed" Style="{StaticResource Card}" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Width="300"><TextBlock Text="Сканируйте QR-код" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center"/><Border Background="White" Padding="10" CornerRadius="10" Margin="0,16" HorizontalAlignment="Center"><Image x:Name="QrImage" Width="250" Height="250"/></Border><TextBlock x:Name="PairingExpiryText" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/><Button Content="Закрыть" Click="ClosePairing"/></StackPanel></Border></Grid>
      </Grid>
      <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel><TextBlock Text="Настройки" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Поведение PC Remote" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><CheckBox x:Name="AutoStartCheck" Content="Запускать при входе в Windows" Checked="AutoStartChanged" Unchecked="AutoStartChanged"/></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Имя компьютера" FontWeight="SemiBold" Margin="0,0,0,12"/><DockPanel><Button DockPanel.Dock="Right" Content="Сохранить" Click="SaveName" Margin="12,0,0,0"/><TextBox x:Name="ComputerNameBox"/></DockPanel></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Обновления" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="VersionText" Foreground="{DynamicResource SecondaryTextBrush}"/><Button Style="{StaticResource SecondaryButton}" x:Name="UpdateButton" Content="Проверить обновления" Click="CheckUpdates" HorizontalAlignment="Left" Margin="0,14,0,0"/><TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><TextBlock Text="Управление работает только в локальной сети через защищённое соединение." Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"/></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
