<Application x:Class="PCRemote.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="AccentBrush" Color="#6750A4" />
    <SolidColorBrush x:Key="PageBrush" Color="#F7F5FA" />
    <SolidColorBrush x:Key="NavBrush" Color="#ECE6F0" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFDFB" />
    <SolidColorBrush x:Key="TextBrush" Color="#1D1B20" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#625B71" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="4"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="4"/></Style>
  </Application.Resources>
</Application>
